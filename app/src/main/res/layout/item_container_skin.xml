<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_skin_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Rarity Tag -->
    <TextView
        android:id="@+id/tv_skin_rarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rarity_common"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="COMMON"
        android:textColor="@color/primary"
        android:textSize="10sp" />

    <!-- Container Silhouette Preview -->
    <com.aquasort.puzzle.views.SkinPreviewView
        android:id="@+id/preview_skin_view"
        android:layout_width="56dp"
        android:layout_height="125dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Skin Title -->
    <TextView
        android:id="@+id/tv_skin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-bold"
        android:maxLines="1"
        android:text="Classic Tube"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Action Button / State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp">

        <!-- Buy Button -->
        <LinearLayout
            android:id="@+id/layout_btn_buy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tv_skin_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="500"
                android:textColor="@color/bg_gradient_start"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Equip Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_skin_equip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_secondary"
            android:fontFamily="sans-serif-black"
            android:text="EQUIP"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Equipped Badge -->
        <LinearLayout
            android:id="@+id/layout_skin_equipped"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_equipped"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="EQUIPPED"
                android:textColor="#06D6A0"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
