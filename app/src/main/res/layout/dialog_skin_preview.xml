<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_glass_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_preview_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="CONTAINER PREVIEW"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_preview_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_action"
            android:contentDescription="@string/action_cancel"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Large Interactive Animated Preview -->
    <com.aquasort.puzzle.views.SkinPreviewView
        android:id="@+id/preview_large_view"
        android:layout_width="86dp"
        android:layout_height="190dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Tap Hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="✦ Tap container to test pour tilt ✦"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <!-- Skin Title & Rarity -->
    <TextView
        android:id="@+id/tv_preview_skin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:text="Laboratory Beaker"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_preview_skin_rarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_rarity_rare"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:text="RARE"
        android:textColor="@color/accent_gold"
        android:textSize="11sp" />

    <!-- Skin Description -->
    <TextView
        android:id="@+id/tv_preview_skin_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Scientific beaker with pouring spout and measurement graduation marks."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_preview_action"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-black"
            android:text="BUY FOR 500 COINS"
            android:textColor="@color/bg_gradient_start"
            android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
