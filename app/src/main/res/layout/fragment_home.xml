<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="20dp">

    <!-- Top Bar: Settings, Title/Level, Coins Badge -->
    <ImageButton
        android:id="@+id/btn_home_settings"
        android:layout_width="@dimen/btn_action_size"
        android:layout_height="@dimen/btn_action_size"
        android:background="@drawable/bg_btn_action"
        android:contentDescription="@string/cd_settings_button"
        android:src="@drawable/ic_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_home_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coin_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btn_home_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_home_settings">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/cd_coin_icon"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/tv_home_coin_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:text="100"
            android:textColor="@color/accent_gold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Center Hero Section: Decorative Tubes + Aqua Sort Logo -->
    <LinearLayout
        android:id="@+id/layout_home_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/card_home_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_home_settings">

        <!-- Decorative Floating Glass Tubes -->
        <LinearLayout
            android:id="@+id/layout_floating_tubes"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.aquasort.puzzle.views.TubeView
                android:id="@+id/home_tube_1"
                android:layout_width="44dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:rotation="-6" />

            <com.aquasort.puzzle.views.TubeView
                android:id="@+id/home_tube_2"
                android:layout_width="52dp"
                android:layout_height="136dp"
                android:translationY="-6dp" />

            <com.aquasort.puzzle.views.TubeView
                android:id="@+id/home_tube_3"
                android:layout_width="44dp"
                android:layout_height="120dp"
                android:layout_marginStart="10dp"
                android:rotation="6" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="@string/app_tagline"
            android:textColor="@color/secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Continue / Play Card -->
    <LinearLayout
        android:id="@+id/card_home_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@id/layout_home_grid">

        <TextView
            android:id="@+id/tv_home_current_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="LEVEL 1"
            android:textColor="@color/accent_gold"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_home_progress_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 100 COMPLETED"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Play Primary Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_home_play"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-black"
            android:text="@string/action_play"
            android:textColor="@color/bg_gradient_start"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Action Buttons Row (Daily Reward, Shop, Levels, How to Play) -->
    <LinearLayout
        android:id="@+id/layout_home_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layout_home_extra_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btn_home_levels"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/action_level_select"
                android:src="@drawable/ic_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/action_level_select"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_home_daily_reward"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/action_daily_reward"
                android:src="@drawable/ic_daily_reward" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/action_daily_reward"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_home_shop"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/action_shop"
                android:src="@drawable/ic_shop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/action_shop"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_home_how_to_play"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/action_how_to_play"
                android:src="@drawable/ic_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="GUIDE"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Share & Rate Us Bottom Bar -->
    <LinearLayout
        android:id="@+id/layout_home_extra_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btn_home_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:drawableStart="@drawable/ic_rate"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="@string/action_rate_us"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btn_home_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:drawableStart="@drawable/ic_share"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="@string/action_share"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
